# Copy to ~/.config/shinxbot/host.env on each host (host-local; never synced).
# Where LinuxQQ (with the NapCat hook) lives; default /opt/QQ. A user-space
# install from "dpkg -x linuxqq.deb ~/qqnt" lives at ~/qqnt/opt/QQ.
SHINX_QQ_DIR=/opt/QQ
# Failover (tools/ops/shinx-ha.sh)
SHINX_HA_ROLE=primary            # primary | backup
SHINX_HA_PEER=volcano            # ssh alias of the other host
SHINX_HA_PEER_ROOT=/home/sitefan/shinxbot2
#SHINX_HA_THRESHOLD=5            # bad minutes before the backup takes over
#SHINX_HA_SYNC_EVERY=300         # seconds between state pushes
#SHINX_HA_STATE_SYNC=1           # 0 = failover only, no state transfer
